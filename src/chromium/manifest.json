{
  "manifest_version": 3,
  "name": "RABG: Add Beaten Badges to RetroAchievements",
  "version": "1.4.0",
  "description": "Shows your beaten games alongside mastered games in the Game Awards section of RetroAchievements profile pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "RABG Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://retroachievements.org/*",
        "*://*.retroachievements.org/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/gold.svg",
        "icons/silver.svg"
      ],
      "matches": [
        "*://retroachievements.org/*",
        "*://*.retroachievements.org/*"
      ]
    }
  ]
}